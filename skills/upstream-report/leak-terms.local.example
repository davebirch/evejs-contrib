# Format reference for the leak-terms file. Normally you do not edit this file:
# run "node <this skill's folder>/scripts/leak-terms.js init" and it writes your own
# file outside the plugin folder (~/.config/evejs-contrib/leak-terms, or
# %APPDATA%\evejs-contrib\leak-terms on Windows). All entries below are made up.
#
# One term per line. '#' starts a comment; blank lines are ignored.
#   plain text   whole word, case-insensitive ("Acme Hosting" matches "acme hosting")
#   /regex/      a JavaScript regular expression, case-insensitive
#
# The scan always checks home paths, private and shared-address IPs, LAN host names,
# emails, obvious secrets and your git/login/host identity; list only what else you
# would rather not share.

[terms]
Acme Hosting
ExampleCorp
/proj-[a-z]+-internal/

# Your own names (git name and email, login, host). Scanned like terms, except that the one
# line "Signed: <name>" is allowed. "leak-terms init" files proposed identity terms here.
[identity]
Sam Example

# Character names are scanned like terms and are also replaced during redaction.
[character-names]
Pilot Alpha
Pilot Beta
